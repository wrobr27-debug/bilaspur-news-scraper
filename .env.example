# Bilaspur News Scraper - copy to .env and fill in locally.
# .env must remain UNTRACKED (listed in .gitignore). Placeholders only here.

# Descriptive crawler identity. CONTACT_EMAIL is replaced by the value below.
USER_AGENT=BilaspurNewsBot/0.1 (+mailto:CONTACT_EMAIL)

# Contact address for the USER_AGENT. Required for live crawls; never commit it.
CONTACT_EMAIL=your-contact@example.com

# Database (optional override)
DATABASE_URL=sqlite:///data/news.db

# Politeness / limits (optional overrides)
REQUEST_TIMEOUT_S=20
MAX_CONCURRENCY=4
PER_DOMAIN_DELAY_S=2
MAX_RETRIES=3
VERIFICATION_REQUEST_BUDGET=10
BROWSER_CRAWLING_ENABLED=true
LOG_LEVEL=INFO
